// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id               String        @id @db.VarChar(255)
  name                  String?       @db.VarChar(255)
  student_code          String?       @db.VarChar(100)
  group_assigned        String        @db.Char(1)
  start_time            DateTime      @default(now()) @db.Timestamptz
  end_time              DateTime?     @db.Timestamptz
  tutorial_time_seconds Float?        @db.DoublePrecision
  feedback              String?       @db.Text
  major                 String?       @db.VarChar(100)
  ai_frequency          String?       @db.VarChar(100)
  age_group             String?       @db.VarChar(50)
  device                String?       @db.VarChar(50)
  responses             ResponseLog[]
  surveys               SurveyLog[]

  @@map("users")
}

model ResponseLog {
  id                       Int      @id @default(autoincrement())
  user_id                  String   @db.VarChar(255)
  scenario_id              Int
  user_decision            String   @db.VarChar(50)
  time_spent_seconds       Float    @db.DoublePrecision
  is_correct_on_error_case Boolean?
  created_at               DateTime @default(now()) @db.Timestamptz
  hover_count              Int      @default(0)
  hover_details            String?  @db.Text
  chat_count               Int      @default(0)
  chat_history             String?  @db.Text
  interactive_clicks       Int      @default(0)
  telemetry_data           String?  @db.Text
  user                     User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("response_logs")
}

model SurveyLog {
  id           Int      @id @default(autoincrement())
  user_id      String   @db.VarChar(255)
  question_key String   @db.VarChar(100)
  score        Int
  created_at   DateTime @default(now()) @db.Timestamptz
  user         User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("survey_logs")
}
